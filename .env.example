# --- Backend API ---------------------------------------------------
# When VITE_API_BASE is set AND VITE_USE_LIVE=true, the app will hit
# real endpoints instead of local storage.
#
# Leave everything blank while developing locally.
# ---------------------------------------------------------------

VITE_API_BASE=
VITE_WS_URL=
VITE_USE_LIVE=false

# The backend is expected to expose:
#   POST   /auth/login              → { token, user }
#   POST   /auth/signup             → { token, user }
#   GET    /auth/me                 → user
#   PATCH  /account/profile         → { name, email }
#   POST   /account/password        → ok
#   POST   /account/2fa/enable      → { secret, qr }
#   POST   /account/2fa/verify      → ok
#   POST   /account/kyc             → { status }
#   GET    /wallet/balance          → { amount }
#   POST   /wallet/deposit          → tx
#   POST   /wallet/withdraw         → tx
#   GET    /wallet/history          → [tx]
#   GET    /markets                 → [market]
#   GET    /markets/:id/price       → { price, change }
#   GET    /trades?status=open      → [position]
#   GET    /trades?status=closed    → [position]
#   POST   /trades                  → position
#   POST   /trades/:id/settle       → position
#   POST   /trades/auto/start       → ok
#   POST   /trades/auto/stop        → ok
